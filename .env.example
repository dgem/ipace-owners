# Copy this file to .env. The repo-root .env is ignored by Git and loaded by
# scripts/infra-env.sh when running `make infra-apply ENV=staging|production`.
# Keep provider credentials here only; merchandise_config belongs in the
# environment's ignored OpenTofu tfvars file and must contain no secrets.

# Existing application secrets (shared unless you deliberately scope them).
# VIN_PEPPER=
# RESEND_API_KEY=
# IDEAL_POSTCODES_API_KEY=
# INSTAGRAM_ACCESS_TOKEN=

# Commerce credentials are environment-scoped to avoid test/live crossover.
# PRINTIFY_API_TOKEN_STAGING=
# PRINTIFY_WEBHOOK_SECRET_STAGING=
# STRIPE_SECRET_KEY_STAGING=sk_test_...
# STRIPE_WEBHOOK_SECRET_STAGING=whsec_...
#
# PRINTIFY_API_TOKEN_PRODUCTION=
# PRINTIFY_WEBHOOK_SECRET_PRODUCTION=
# STRIPE_SECRET_KEY_PRODUCTION=sk_live_...
# STRIPE_WEBHOOK_SECRET_PRODUCTION=whsec_...

# If the same Printify API token is intentionally used in both environments,
# use PRINTIFY_API_TOKEN without a suffix instead of duplicating it above.
