---
layout: base.njk
---
<div class="page-header">
  <div class="container">
    {% if eyebrow %}<p class="page-header__eyebrow">{{ eyebrow }}</p>{% endif %}
    <h1 class="page-header__title">{{ title }}</h1>
    {% if subtitle %}<p class="page-header__subtitle">{{ subtitle }}</p>{% endif %}
  </div>
</div>

{% if heroImage %}
<figure class="page-hero-image container">
  <img src="{{ heroImage }}" alt="{{ heroImageAlt | default('') }}"{% if heroImageAlt %} loading="eager"{% else %} aria-hidden="true"{% endif %}>
</figure>
{% endif %}

<div class="section">
  <div class="container">
    <div class="prose">
      {{ content | safe }}
    </div>
  </div>
</div>
