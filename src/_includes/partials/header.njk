<header class="site-header" role="banner">
  <div class="container">
    <div class="site-header__inner">

      <!-- Logo / wordmark -->
      <a href="/" class="site-header__logo" aria-label="{{ site.title }} home">
        i-Pace Owners
        <span>Advocacy Group</span>
      </a>

      <!-- Desktop navigation -->
      <nav class="site-nav" aria-label="Main navigation">
        {% for item in navigation.public %}
          {% if item.highlight %}
            <a
              href="{{ item.url }}"
              class="site-nav__link site-nav__link--highlight"
              data-nav-link
              data-requires-guest
              {% if item.launchVisible == false %}data-site-mode-only="full"{% endif %}
            >{{ item.label }}</a>
          {% else %}
            <a
              href="{{ item.url }}"
              class="site-nav__link"
              data-nav-link
              {% if item.launchVisible == false %}data-site-mode-only="full"{% endif %}
            >{{ item.label }}</a>
          {% endif %}
        {% endfor %}
      </nav>

      <!-- Header actions -->
      <div class="site-header__actions">
        <div class="identity-controls">
          <a id="identity-user-display" class="identity-controls__user btn btn--sm btn--ghost" href="/member/account/" data-requires-auth style="display:none"></a>
          <a id="identity-login-btn" class="btn btn--sm btn--ghost" href="/member/account/">Sign in</a>
          <a href="/member/dashboard/" class="btn btn--sm btn--primary" data-requires-auth style="display:none">My Data</a>
          <button id="identity-logout-btn" class="btn btn--sm btn--ghost" type="button" style="display:none">Sign out</button>
        </div>

        <a id="identity-mobile-header-login-btn" class="btn btn--sm btn--ghost mobile-header-login" href="/member/account/">Sign in</a>

        <!-- Mobile menu toggle -->
        <button
          id="mobile-menu-toggle"
          class="mobile-menu-toggle"
          aria-expanded="false"
          aria-controls="mobile-nav"
          aria-label="Open navigation menu"
          type="button"
        >
          <svg width="20" height="20" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
            <rect y="3" width="20" height="2" rx="1"/>
            <rect y="9" width="20" height="2" rx="1"/>
            <rect y="15" width="20" height="2" rx="1"/>
          </svg>
        </button>
      </div>

    </div>

    {% if memberNavigation %}
    <nav class="site-context-nav" aria-label="Member breadcrumb">
      <ol class="site-context-nav__list">
        <li>
          {% if memberBreadcrumb == "My data" %}
          <span class="site-context-nav__section">Member</span>
          {% else %}
          <a class="site-context-nav__section" href="/member/dashboard/">Member</a>
          {% endif %}
        </li>
        <li class="site-context-nav__separator" aria-hidden="true">›</li>
        <li><span class="site-context-nav__current" aria-current="page">{{ memberBreadcrumb }}</span></li>
      </ol>
    </nav>
    {% endif %}

    <nav class="site-admin-nav" aria-label="Admin navigation" data-requires-admin style="display:none">
      <a class="site-admin-nav__label" href="/admin/" data-nav-link>Admin</a>
      {% for item in navigation.admin %}
        <a href="{{ item.url }}" class="site-admin-nav__link" data-nav-link>{{ item.label }}</a>
      {% endfor %}
    </nav>
  </div>
</header>
