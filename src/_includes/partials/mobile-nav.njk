<nav id="mobile-nav" class="mobile-nav" aria-label="Mobile navigation" aria-hidden="false">
  <ul class="mobile-nav__list" role="list">
    {% for item in navigation.public %}
      <li{% if item.launchVisible == false %} data-site-mode-only="full"{% endif %}>
        {% if item.highlight %}
          <a
            href="{{ item.url }}"
            class="mobile-nav__link mobile-nav__link--highlight"
            data-nav-link
            data-requires-guest
          >{{ item.label }}</a>
        {% else %}
          <a
            href="{{ item.url }}"
            class="mobile-nav__link"
            data-nav-link
          >{{ item.label }}</a>
        {% endif %}
      </li>
    {% endfor %}
  </ul>

  <div class="mobile-nav__admin" data-requires-admin style="display:none">
    <p class="mobile-nav__section-label"><a href="/admin/" data-nav-link>Admin</a></p>
    <ul class="mobile-nav__list" role="list">
      {% for item in navigation.admin %}
        <li><a href="{{ item.url }}" class="mobile-nav__link" data-nav-link>{{ item.label }}</a></li>
      {% endfor %}
    </ul>
  </div>

  <div class="mobile-nav__identity">
    <p class="mobile-nav__identity-label">Member</p>
    {% for item in navigation.member %}
    <a href="{{ item.url }}" class="btn btn--sm {% if item.url == '/member/dashboard/' %}btn--primary{% else %}btn--secondary{% endif %} full-width" data-nav-link data-requires-auth style="display:none">{{ item.label }}</a>
    {% endfor %}
    <a id="identity-mobile-login-btn" class="btn btn--sm btn--secondary full-width" href="/member/account/">Sign in</a>
    <button id="identity-mobile-logout-btn" class="btn btn--sm btn--ghost full-width" type="button" style="display:none">Sign out</button>
  </div>
</nav>
