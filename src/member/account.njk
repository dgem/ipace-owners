---
layout: base.njk
title: Account
description: "Your account — I-PACE Owners' Advocacy Group."
noindex: true
memberExport: true
surveys: true
memberNavigation: true
memberBreadcrumb: Account
date: Last Modified
---

{% from "partials/auth-login-gate.njk" import authLoginGate %}

<div class="page-header page-header--compact">
	<div class="container">
		<h1 class="page-header__title">Your Account</h1>
	</div>
</div>

<div class="section">
	<div class="container">

			 <!-- Server-side auth container: member-auth.js verifies via /api/member-data -->
			<div data-auth-container>

				{{ authLoginGate("account-magic-email", "Sign in to view your account", "Enter your email address and we will send a secure sign-in link so you can access your membership details, track data for one or more vehicles, and manage your preferences.") }}

				 <!-- Content — revealed by member-auth.js after server confirms auth -->
				<div class="auth-content" data-auth-content hidden>
					<section class="survey-dashboard-callout" data-member-survey-summary aria-live="polite">
						<p>Loading member surveys…</p>
					</section>
					<div class="account-layout">

						<div class="dashboard-panel">
							<div class="dashboard-panel__header">
								<h2 class="dashboard-panel__title">Account details</h2>
							</div>
							<dl style="display:grid; grid-template-columns: 8rem 1fr; gap: var(--space-2) var(--space-4); font-size: var(--text-sm);">
								<dt style="color:var(--color-text-muted); font-weight:600;">Email</dt>
								<dd id="account-email" style="margin:0;">—</dd>
								<dt style="color:var(--color-text-muted); font-weight:600;">Member since</dt>
								<dd id="account-created" style="margin:0;">—</dd>
								<dt style="color:var(--color-text-muted); font-weight:600;">Role</dt>
								<dd id="account-role" style="margin:0;"><span class="badge">Member</span></dd>
							</dl>
							<div class="cluster" style="margin-top: var(--space-5); padding-top: var(--space-5); border-top: 1px solid var(--color-border);">
								<a href="/member/dashboard/" class="btn btn--primary btn--sm">Vehicle Data</a>
								<a href="/member/surveys/" class="btn btn--secondary btn--sm">Member surveys</a>
								<button id="account-logout-btn" class="btn btn--secondary btn--sm" type="button">Sign out</button>
							</div>
						</div>

						<div class="dashboard-panel">
							<div class="dashboard-panel__header">
								<h2 class="dashboard-panel__title">Your preferences</h2>
							</div>
							<div data-preferences-container>
								<p style="color:var(--color-text-muted); font-size:var(--text-sm);">Loading...</p>
							</div>
						</div>

						<div class="dashboard-panel account-layout__wide">
							<div class="dashboard-panel__header">
								<div>
									<h2 class="dashboard-panel__title">Your vehicles</h2>
									<p class="dashboard-panel__lede">Registered I-PACE records attached to your member account.</p>
								</div>
								<a href="/member/submit-vehicle-data/" class="btn btn--primary btn--sm">Add another vehicle</a>
							</div>
							<div data-vehicle-container>
								<div data-vehicle-list>
									<p style="color:var(--color-text-muted); font-size:var(--text-sm);">Loading...</p>
								</div>
							</div>
						</div>

						<div class="dashboard-panel account-layout__wide">
							<div class="dashboard-panel__header">
								<div>
									<h2 class="dashboard-panel__title">Export your data</h2>
									<p class="dashboard-panel__lede">Download a portable copy of the membership, vehicle, battery and service information currently saved in your account.</p>
								</div>
							</div>
							<div class="member-export-options">
								<div class="member-export-option">
									<div>
										<h3>Separate CSV files</h3>
										<p>Four straightforward CSV files in one ZIP: membership, vehicles, SoH readings, and service and fault history.</p>
									</div>
									<button class="btn btn--secondary" type="button" data-member-export="csv">Download CSV bundle</button>
								</div>
								<div class="member-export-option">
									<div>
										<h3>Excel report</h3>
										<p>A formatted workbook with separate sheets, a summary and charts for SoH history and service or fault events where data is available.</p>
										<p class="form-hint"><a href="/downloads/sample-ipace-owner-data.xlsx">Download a sample report</a> made with fictional data.</p>
									</div>
									<button class="btn btn--primary" type="button" data-member-export="xlsx">Download Excel report</button>
								</div>
							</div>
							<p class="form-hint">Exports are generated securely for the signed-in account and are not cached. They may contain personal information, so store and share them carefully.</p>
							<p class="member-export-status" data-member-export-status role="status" aria-live="polite"></p>
						</div>

					</div>
				</div>
			</div>

	</div>
</div>

<script>
// Populate account details from the current Firebase session. Data access remains server-verified.
(function() {
	function populateAccount() {
		var user = window.ipaceIdentityUser;
		if (!user) return;
		var emailEl = document.getElementById('account-email');
		var createdEl = document.getElementById('account-created');
		var roleEl = document.getElementById('account-role');
		var logoutBtn = document.getElementById('account-logout-btn');

		if (emailEl) emailEl.textContent = user.email || '—';
		if (createdEl && user.created_at) {
			createdEl.textContent = new Date(user.created_at).toLocaleDateString('en-GB');
		}
		if (logoutBtn) {
			logoutBtn.addEventListener('click', function() {
				var headerLogout = document.getElementById('identity-logout-btn');
				if (headerLogout) headerLogout.click();
			});
		}
	}

	document.addEventListener('identity:ready', populateAccount);
	document.addEventListener('identity:login', populateAccount);
})();
</script>
