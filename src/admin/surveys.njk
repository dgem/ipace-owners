{% from "partials/auth-login-gate.njk" import authLoginGate %}
<div class="page-header page-header--compact"><div class="container"><h1 class="page-header__title">Member surveys</h1></div></div>
<div class="section"><div class="container" data-admin-container>
  {{ authLoginGate("survey-admin-email", "Sign in required", "Enter your admin email address and we will send a secure sign-in link.", "admin", false) }}
  <div class="auth-gate" data-admin-only-gate hidden><div class="auth-gate__icon" aria-hidden="true">⛔</div><h2 class="auth-gate__title">Access restricted</h2><p class="auth-gate__body">This workspace is for group administrators only.</p></div>
  <div class="auth-content" data-admin-content hidden data-survey-admin>
    <section class="dashboard-panel"><div class="dashboard-panel__header"><div><p class="dashboard-panel__eyebrow">All surveys</p><h2 class="dashboard-panel__title">Existing surveys</h2></div><button class="btn btn--secondary btn--sm" data-survey-refresh type="button">Refresh</button></div><p class="form-hint">Preview and test draft surveys before publishing. Open a survey's admin-only results to review masked responses and download a PII-safe CSV.</p><div class="stack" data-survey-admin-list aria-live="polite">Loading surveys…</div></section>
    <section class="dashboard-panel"><div class="dashboard-panel__header"><div><p class="dashboard-panel__eyebrow">Survey manager</p><h2 class="dashboard-panel__title">Create or edit a survey</h2></div></div>
      <form class="stack" data-survey-editor>
        <input type="hidden" data-survey-id>
        <div class="form-group"><label for="survey-title">Title</label><input class="survey-editor__title" id="survey-title" data-survey-title type="text" maxlength="120" required placeholder="Preferred outcomes"></div>
        <div class="form-group"><label for="survey-description">Description</label><textarea id="survey-description" data-survey-description maxlength="4000" rows="6" placeholder="Context for members. Markdown supported, for example **bold** and lists."></textarea><p class="form-hint">Public. Markdown is supported; HTML is shown as text.</p></div>
        <div class="form-group"><label for="survey-question">Question or prompt <span class="form-hint">(optional)</span></label><textarea id="survey-question" data-survey-question maxlength="500" rows="3" placeholder="Which outcomes should we prioritise in discussions with JLR?"></textarea></div>
        <div class="form-group"><label for="survey-cta">Call to action</label><textarea id="survey-cta" data-survey-cta maxlength="1000" rows="3" placeholder="Help us steer JLR by selecting the outcomes you would find acceptable."></textarea><p class="form-hint">Public. Markdown is supported; HTML is shown as text.</p></div>
        <div class="grid grid--2"><div class="form-group"><label for="survey-start">Live from</label><input id="survey-start" data-survey-start type="date" required></div><div class="form-group"><label for="survey-end">Live to (inclusive)</label><input id="survey-end" data-survey-end type="date" required></div></div>
        <fieldset class="form-group"><legend class="form-label">Publication, response and results</legend><label for="survey-status">Status<select id="survey-status" data-survey-status><option value="draft">Draft — admin only</option><option value="published">Published — visible to members</option></select></label><p class="form-hint">Draft surveys are not visible to members.</p><label><input data-survey-multiple type="checkbox"> Allow members to choose more than one option</label><br><label><input data-survey-results type="checkbox" checked> Let members view aggregate results after they respond, or once the survey closes</label></fieldset>
        <div class="form-group"><span class="form-label">Options</span><div class="stack" data-survey-options></div><button class="btn btn--secondary btn--sm" data-survey-add-option type="button">Add option</button><p class="form-hint">Give each option a short name for results, plus a public Markdown description for members. Offer optional short text where a member may want to add up to 250 characters.</p></div>
        <div class="cluster"><button class="btn btn--primary" type="submit">Save survey</button><button class="btn btn--secondary" data-survey-new type="button">New survey</button></div><p data-survey-admin-status role="status" aria-live="polite"></p>
      </form>
    </section>
  </div>
</div></div>
