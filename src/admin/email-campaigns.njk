{% from "partials/auth-login-gate.njk" import authLoginGate %}

<div class="page-header page-header--compact"><div class="container"><h1 class="page-header__title">Registration reminders</h1></div></div>
<div class="section section--sm"><div class="container"><div data-admin-container>
  {{ authLoginGate("campaign-magic-email", "Sign in required", "Enter your admin email address and we will send a secure sign-in link.", "admin", false) }}
  <div class="auth-gate" data-admin-only-gate hidden><div class="auth-gate__icon" aria-hidden="true">⛔</div><h2 class="auth-gate__title">Access restricted</h2><p class="auth-gate__body">This workspace is for group administrators only.</p></div>
  <div class="auth-content" data-admin-content hidden>
    <section class="dashboard-panel" data-email-campaign data-preview-endpoint="/api/admin/reengagement-preview" data-send-endpoint="/api/admin/reengagement-send">
      <div class="dashboard-panel__header"><div><p class="dashboard-panel__eyebrow">Transactional sign-in links</p><h2 class="dashboard-panel__title">Remind people to finish joining</h2></div></div>
      <p class="dashboard-panel__lede">Use this only for people who started joining but have not completed sign-in. Each recipient receives a fresh private Firebase sign-in link. For all consented-member updates, including the September survey, use <a href="/admin/marketing-messages/">Marketing Messages</a>.</p>
      <div class="email-campaign-step">
        <p class="dashboard-panel__eyebrow">Step 1</p>
        <h3>Check the recipients and preview the email</h3>
        <p>No email is sent during this step.</p>
        <div class="cluster"><button type="button" class="btn btn--primary" data-campaign-preview>Check recipients and load email preview</button></div>
      </div>
      <div data-campaign-summary class="stack" aria-live="polite"></div>
      <section class="email-preview" data-campaign-email-preview hidden aria-labelledby="email-preview-title">
        <p class="dashboard-panel__eyebrow">Email preview</p><h3 id="email-preview-title">What each recipient will receive</h3>
        <p><strong>Subject:</strong> <span data-campaign-email-subject></span></p>
        <div class="email-preview__viewport"><iframe data-campaign-email-html title="Rendered HTML registration-reminder email preview" sandbox></iframe></div>
        <details class="email-preview__plain"><summary>View plain-text alternative</summary><pre data-campaign-email-text></pre></details>
      </section>
      <form data-campaign-send class="stack email-campaign-step">
        <div><p class="dashboard-panel__eyebrow">Step 2</p><h3>Confirm and send the reminders</h3><p>The controls unlock after Step 1 confirms the current audience.</p></div>
        <div class="form-group email-campaign-confirmation"><label for="campaign-confirm">Type the exact confirmation shown below</label><input id="campaign-confirm" type="text" data-campaign-confirm autocomplete="off" disabled><p class="form-hint" data-campaign-confirm-hint>Check the recipients and email preview first.</p></div>
        <button type="submit" class="btn btn--danger" data-campaign-send-button disabled>Send registration reminders</button>
      </form>
      <p data-campaign-status role="status" aria-live="polite">No email has been sent.</p>
    </section>
  </div>
</div></div></div>
