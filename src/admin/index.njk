{% from "partials/auth-login-gate.njk" import authLoginGate %}

<div class="page-header page-header--compact">
  <div class="container">
    <h1 class="page-header__title">Dashboard</h1>
  </div>
</div>

<div class="section">
  <div class="container" data-admin-container>
    {{ authLoginGate("admin-dashboard-email", "Sign in required", "Enter your admin email address and we will send a secure sign-in link.", "admin", false) }}

    <div class="auth-gate" data-admin-only-gate hidden>
      <div class="auth-gate__icon" aria-hidden="true">⛔</div>
      <h2 class="auth-gate__title">Access restricted</h2>
      <p class="auth-gate__body">This dashboard is for group administrators only.</p>
    </div>

    <div class="auth-content" data-admin-content hidden>
      <div class="stack admin-dashboard-stack">
        <div class="admin-dashboard-tools-intro">
          <p class="dashboard-panel__eyebrow">Active tools</p>
          <h2>Administration and member growth</h2>
          <p>Review live submissions, collect member views, help owners find the group, and run controlled email and Instagram campaigns.</p>
        </div>

        <div class="grid grid--3 admin-dashboard-grid admin-dashboard-tools">
          <article class="card">
            <div class="admin-tool-logo" aria-hidden="true"><svg viewBox="0 0 32 32" fill="none"><circle cx="14" cy="14" r="8" stroke="currentColor" stroke-width="2"/><path d="m20 20 7 7" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/><path d="M10 12h8M10 16h5" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg></div>
            <h3 class="card__title">Member administration</h3>
            <div class="card__body"><p>Find members, filter interests and countries, and approve feature testers.</p></div>
            <a class="btn btn--primary" href="/admin/members/">Manage members</a>
          </article>
          <article class="card">
            <div class="admin-tool-logo" aria-hidden="true"><svg viewBox="0 0 32 32" fill="none"><path d="M6 26V15M13 26V6M20 26V11M27 26V3" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/><path d="M4 27h25" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg></div>
            <h3 class="card__title">Statistics</h3>
            <div class="card__body"><p>View campaign performance, member growth, vehicles and service evidence statistics.</p></div>
            <a class="btn btn--primary" href="/admin/stats/">View statistics</a>
          </article>
          <article class="card">
            <div class="admin-tool-logo" aria-hidden="true"><svg viewBox="0 0 32 32" fill="none"><path d="M7 5h13l5 5v17H7V5Z" stroke="currentColor" stroke-width="2"/><path d="M20 5v6h5M11 16h10M11 21h7" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg></div>
            <h3 class="card__title">Member experiences</h3>
            <div class="card__body"><p>Edit, analyse, approve and publish member experiences with their permissions and linked evidence.</p></div>
            <a class="btn btn--primary" href="/admin/member-stories/">Review experiences</a>
          </article>
          <article class="card">
            <div class="admin-tool-logo" aria-hidden="true">
              <svg viewBox="0 0 32 32" fill="currentColor">
                <path d="M18.2 28V17.1h3.7l.5-4.2h-4.2v-2.7c0-1.2.4-2.1 2.1-2.1h2.3V4.3c-.4-.1-1.8-.2-3.3-.2-3.3 0-5.5 2-5.5 5.7v3.1H10v4.2h3.8V28h4.4Z"/>
              </svg>
            </div>
            <h3 class="card__title">Facebook outreach</h3>
            <div class="card__body"><p>Build manual Facebook searches and draft helpful, transparent responses to owners.</p></div>
            <a class="btn btn--primary" href="/admin/outreach/">Facebook Assistant</a>
          </article>
          <article class="card">
            <div class="admin-tool-logo" aria-hidden="true">
              <svg viewBox="0 0 32 32" fill="none">
                <rect x="4" y="7" width="24" height="18" rx="2" stroke="currentColor" stroke-width="2"/>
                <path d="m5 9 11 9 11-9" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/>
              </svg>
            </div>
            <h3 class="card__title">Registration reminders</h3>
            <div class="card__body"><p>Send fresh sign-in links to people who started, but did not finish, joining.</p></div>
            <a class="btn btn--primary" href="/admin/email-campaigns/">Registration Reminders</a>
          </article>
          <article class="card">
            <div class="admin-tool-logo" aria-hidden="true">
              <svg viewBox="0 0 32 32" fill="none"><path d="M5 8h22v16H5zM5 9l11 8 11-8" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/><path d="M10 5h12" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
            </div>
            <h3 class="card__title">Mass mailings</h3>
            <div class="card__body"><p>Send prepared campaigns, including the September survey, or a new Resend broadcast to members who opted in to group communications.</p></div>
            <a class="btn btn--primary" href="/admin/marketing-messages/">Mass Mailings</a>
          </article>
          <article class="card">
            <div class="admin-tool-logo" aria-hidden="true">
              <svg viewBox="0 0 32 32" fill="none">
                <rect x="4" y="4" width="24" height="24" rx="7" stroke="currentColor" stroke-width="2"/>
                <circle cx="16" cy="16" r="5.5" stroke="currentColor" stroke-width="2"/>
                <circle cx="23.5" cy="8.5" r="1.5" fill="currentColor"/>
              </svg>
            </div>
            <h3 class="card__title">Instagram campaigns</h3>
            <div class="card__body"><p>Review a chat-prepared Reel and caption, then publish only after an exact confirmation.</p></div>
            <a class="btn btn--primary" href="/admin/instagram-campaigns/">Instagram Campaigns</a>
          </article>
          <article class="card">
            <div class="admin-tool-logo" aria-hidden="true">
              <svg viewBox="0 0 32 32" fill="none">
                <rect x="5" y="4" width="22" height="24" rx="3" stroke="currentColor" stroke-width="2"/>
                <path d="M10 11h12M10 16h12M10 21h7" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
              </svg>
            </div>
            <h3 class="card__title">Member surveys</h3>
            <div class="card__body"><p>Create time-limited member surveys, collect responses, and share aggregate results.</p></div>
            <a class="btn btn--primary" href="/admin/surveys/">Member Surveys</a>
          </article>
        </div>

      </div>
    </div>
  </div>
</div>
