{
  "name": "ipace-owners",
  "version": "0.1.0",
  "description": "I-PACE Owners' Advocacy Group website",
  "private": true,
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "eleventy --serve",
    "build": "eleventy",
    "clean": "rm -rf _site",
    "lint:js": "eslint .eleventy.js scripts test src/assets/js",
    "lint:css": "stylelint \"src/**/*.css\"",
    "lint:markdown": "markdownlint-cli2",
    "lint:data": "prettier --check \"**/*.{json,yaml,yml}\" \"!node_modules/**\" \"!_site/**\" \"!firebase-preview.json\"",
    "test": "node --test",
    "test:visual": "node scripts/visual-check.mjs",
    "smoke:deployment": "node scripts/smoke-test-deployment.mjs"
  },
  "dependencies": {
    "@11ty/eleventy": "^3.0.0",
    "jszip": "3.10.2",
    "pptxgenjs": "4.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.11.0",
    "fast-xml-parser": "^5.11.2",
    "firebase-tools": "^15.32.1",
    "globals": "^17.13.0",
    "markdownlint-cli2": "^0.23.3",
    "nunjucks-date-filter": "^0.1.1",
    "playwright-core": "^1.63.0",
    "prettier": "^3.9.9",
    "stylelint": "^17.16.0",
    "stylelint-config-recommended": "^18.0.0"
  },
  "overrides": {
    "@hono/node-server": "2.0.11",
    "@opentelemetry/core": "2.10.0",
    "brace-expansion": "5.0.12",
    "gaxios": "7.3.0",
    "image-size": "2.0.4",
    "markdownlint-cli2": {
      "js-yaml": "5.4.2",
      "smol-toml": "1.8.0"
    },
    "basic-ftp": "6.2.1",
    "@11ty/eleventy": {
      "markdown-it": "14.3.1"
    }
  }
}
