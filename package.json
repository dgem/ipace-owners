{
  "name": "ipace-owners",
  "version": "0.1.0",
  "description": "I-PACE Owners' Advocacy Group website",
  "private": true,
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "eleventy --serve",
    "build": "eleventy",
    "clean": "rm -rf _site",
    "lint:js": "eslint .eleventy.js scripts test src/assets/js",
    "lint:css": "stylelint \"src/**/*.css\"",
    "lint:markdown": "markdownlint-cli2",
    "lint:data": "prettier --check \"**/*.{json,yaml,yml}\" \"!node_modules/**\" \"!_site/**\" \"!firebase-preview.json\"",
    "test": "node --test",
    "test:visual": "node scripts/visual-check.mjs",
    "smoke:deployment": "node scripts/smoke-test-deployment.mjs"
  },
  "dependencies": {
    "@11ty/eleventy": "^3.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.8.1",
    "fast-xml-parser": "^5.11.0",
    "firebase-tools": "^15.27.0",
    "globals": "^17.11.0",
    "markdownlint-cli2": "^0.23.2",
    "nunjucks-date-filter": "^0.1.1",
    "playwright-core": "^1.62.1",
    "prettier": "^3.9.6",
    "stylelint": "^17.14.1",
    "stylelint-config-recommended": "^18.0.0"
  },
  "overrides": {
    "@hono/node-server": "2.0.11",
    "@opentelemetry/core": "2.10.0",
    "brace-expansion": "5.0.9",
    "gaxios": "7.3.0",
    "markdownlint-cli2": {
      "js-yaml": "5.2.2"
    }
  }
}
